#!/usr/bin/env bash
# heimdall — control the Heimdall stack installed by the heimdall .deb package.
#
#   heimdall setup [setup.sh options]   generates secrets and .env (first time only)
#   heimdall start                      start now and at every boot
#   heimdall stop                       stop, and do not start at boot
#   heimdall upgrade                    pull the images for the installed version and restart
#   heimdall status | logs [service] | password | version
#   heimdall reset-login                remove the dashboard admin account so a new one can be created (data is kept)
#   heimdall reset                      DELETE all data, secrets and .env (asks first)
#
# Everything except `version` and `help` needs root (sudo): it controls Docker
# and reads the generated secrets.
set -euo pipefail

DIR="${HEIMDALL_HOME:-/opt/heimdall}"
UNIT=heimdall.service

die() { echo "heimdall: $*" >&2; exit 1; }

version() { tr -d '[:space:]' < "$DIR/VERSION" 2>/dev/null || echo unknown; }

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

has_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null; }

compose() { (cd "$DIR" && docker compose "$@"); }

need_root() { [ "$(id -u)" -eq 0 ] || [ -n "${HEIMDALL_HOME:-}" ] || die "run this with sudo: sudo heimdall ${1:-}"; }

need_setup() { [ -f "$DIR/.env" ] || die "not set up yet — run: sudo heimdall setup"; }

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
    version|-v|--version) version ;;
    help|-h|--help) usage ;;
    setup)
        need_root setup
        (cd "$DIR" && ./setup.sh "$@")
        ;;
    start)
        need_root start; need_setup
        if has_systemd; then systemctl enable --now "$UNIT"; else compose pull && compose up -d; fi
        echo "Dashboard: http://<this-machine>:3000"
        if [ -s "$DIR/secrets/admin_password.txt" ]; then echo "Sign in with the existing login (sudo heimdall password shows the password)."
        else echo "First visit: create your admin account in the browser (forgotten it later? sudo heimdall reset-login)."; fi
        ;;
    stop)
        need_root stop
        if has_systemd; then systemctl disable --now "$UNIT"; else compose stop; fi
        ;;
    upgrade)
        need_root upgrade; need_setup
        # `apt upgrade` already moved IMAGE_TAG (postinst); this fetches the images and restarts.
        compose pull && compose up -d
        ;;
    status)
        need_root status; need_setup
        echo "Heimdall $(version)"
        compose ps
        ;;
    logs)
        need_root logs; need_setup
        compose logs -f --tail 100 "$@"
        ;;
    password)
        need_root password
        [ -s "$DIR/secrets/admin_password.txt" ] || die "no password file: this install's admin account was created in the dashboard and only a hash is kept. Forgotten it? sudo heimdall reset-login"
        cat "$DIR/secrets/admin_password.txt"
        ;;
    reset-login)
        # Removes the dashboard admin account so the next visit offers account creation again. Data is kept.
        need_root reset-login; need_setup
        compose exec -T postgres psql -U sentinel -d sentinel -c "DELETE FROM admin_account" >/dev/null \
            || die "could not reach the database — is Heimdall running? (sudo heimdall start)"
        : > "$DIR/secrets/admin_password.txt"
        # An older install holds its password file's contents in memory: restart so the page opens for setup.
        compose restart sentinel-backend >/dev/null
        echo "Done. Open the dashboard and create a new admin account; do it now, the page is open to anyone who reaches it until you do."
        ;;
    reset)
        need_root reset
        echo "This deletes the Heimdall database, every generated secret and .env."
        read -rp "Type 'delete' to continue: " answer
        [ "$answer" = delete ] || die "cancelled"
        if has_systemd; then systemctl disable --now "$UNIT" 2>/dev/null || true; fi
        if [ -f "$DIR/docker-compose.yml" ]; then compose down -v || true; fi
        rm -rf "${DIR:?}/secrets" "${DIR:?}/.env"
        echo "Done. Run 'sudo heimdall setup' to start fresh."
        ;;
    *) usage >&2; exit 2 ;;
esac

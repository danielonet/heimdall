# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
# The whole directory, not a blanket `*.txt` — that project-wide rule used to
# also silently exclude sentinel/requirements.txt from every commit in this
# project's history (a fresh clone couldn't have built the backend image:
# `COPY requirements.txt .` would fail outright).
secrets/

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.install_stamp
*.coverage
.coverage
htmlcov/

# ── ML models ─────────────────────────────────────────────────────────────────
/data/models/
.data/
*.joblib
*.pkl


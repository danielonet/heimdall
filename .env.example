# Heimdall Configuration
# Copy this to .env and fill in your values. Secrets should be stored in Docker secrets.

# ───────────────────────────────────────────────────────────────────────────────
# ROUTER CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Router adapter type (currently only 'sagemcom' is supported)
ROUTER_ADAPTER=sagemcom

# Router IP address on the LAN
# Leave blank to auto-discover from the default gateway
ROUTER_IP=

# Router admin port (typically 80 for HTTP)
ROUTER_PORT=80

# Router username (default: admin for Sagemcom)
ROUTER_USERNAME=admin

# Router admin password (loaded from Docker secret in production)
# File-based secret for Docker: ROUTER_PASSWORD_FILE=/run/secrets/router_password
# Or environment variable (dev only): ROUTER_PASSWORD=your_password
ROUTER_PASSWORD_FILE=/run/secrets/router_password

# Polling interval for router status queries (in seconds)
POLL_INTERVAL_SECONDS=15

# ───────────────────────────────────────────────────────────────────────────────
# MOCK ROUTER FOR OFFLINE DEVELOPMENT
# ───────────────────────────────────────────────────────────────────────────────

# Enable the mock Sagemcom adapter for offline development
# When true: Returns synthetic test data (no router connection needed)
# When false: Connects to real router at ROUTER_IP
# See: docs/architecture/10-mock-router.md
USE_MOCK_ROUTER=false

# ───────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string with asyncpg driver
# In production, use a strong password from Docker secrets
DATABASE_URL=postgresql+asyncpg://sentinel:pass@localhost/sentinel

# Database password (loaded from Docker secret in production)
# File-based: DB_PASS_FILE=/run/secrets/db_pass
DB_PASS=pass

# ───────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Redis connection string for pub/sub and caching
# Default: localhost:6379 (when running in docker-compose with network_mode: host)
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ───────────────────────────────────────────────────────────────────────────────

# Secret key for JWT token signing (loaded from Docker secret in production)
# In development, this can be any random string
# File-based: JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# JWT access token TTL (in seconds)
# Default: 900 = 15 minutes
JWT_ACCESS_TOKEN_EXPIRES=900

# JWT refresh token TTL (in seconds)
# Default: 604800 = 7 days
JWT_REFRESH_TOKEN_EXPIRES=604800

# ───────────────────────────────────────────────────────────────────────────────
# MACHINE LEARNING
# ───────────────────────────────────────────────────────────────────────────────

# Minimum number of traffic samples before ML model training begins
ML_MIN_SAMPLES_TO_TRAIN=100

# Contamination ratio for anomaly detection (fraction of expected anomalies)
# Range: 0.0 to 1.0, default: 0.05 = 5% of traffic marked anomalous
ML_CONTAMINATION=0.05

# Cron schedule for automated ML model retraining
# Format: minute hour day month day_of_week (cron syntax)
# Default: 03:00 UTC daily
ML_RETRAIN_CRON=0 3 * * *

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY SERVICES
# ───────────────────────────────────────────────────────────────────────────────

# OpenThreatExchange (OTX) API key for threat intelligence
# Register at: https://otx.alienvault.com
# File-based: OTX_API_KEY_FILE=/run/secrets/otx_api_key
OTX_API_KEY=

# LAN-facing network interface for ARP packet sniffing
# Common values: eth0, wlan0, enp0s31f6
SNIFF_IFACE=eth0

# Cron schedule for automated vulnerability scans via nmap
# Default: 02:00 UTC daily
NMAP_SCAN_CRON=0 2 * * *

# ───────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS
# ───────────────────────────────────────────────────────────────────────────────

# Ntfy webhook URL for push alerts
# Optional: e.g., https://ntfy.sh/heimdall-alerts
NTFY_URL=

# SMTP server host for email notifications
# Optional: e.g., smtp.gmail.com
SMTP_HOST=

# SMTP sender email address
# Optional: e.g., heimdall-alerts@example.com
SMTP_FROM=

# ───────────────────────────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────────────────────────

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ───────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT
# ───────────────────────────────────────────────────────────────────────────────

# Flask debug mode (development only — NEVER enable in production)
FLASK_ENV=production
FLASK_DEBUG=false

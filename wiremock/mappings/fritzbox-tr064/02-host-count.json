{
  "request": {
    "method": "POST",
    "urlPath": "/upnp/control/hosts",
    "headers": {
      "SOAPAction": {
        "contains": "#GetHostNumberOfEntries"
      },
      "Authorization": {
        "matches": "Digest .*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/xml; charset=\"utf-8\""
    },
    "bodyFileName": "fritzbox-tr064/host_count.xml",
    "transformers": [
      "response-template"
    ]
  }
}

{
  "request": {
    "method": "ANY",
    "urlPathPattern": "/api/v2/.*"
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": 401,
      "status": "unauthorized",
      "response_id": "AUTH_REQUIRED",
      "message": "Authentication required."
    },
    "transformers": [
      "response-template"
    ]
  },
  "priority": 20
}

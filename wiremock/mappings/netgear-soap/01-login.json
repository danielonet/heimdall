{
  "request": {
    "method": "POST",
    "urlPath": "/soap/server_sa",
    "headers": {
      "SOAPAction": {
        "contains": "DeviceConfig:1#SOAPLogin"
      }
    },
    "bodyPatterns": [
      {
        "contains": "<Password>sim-password</Password>"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/xml; charset=\"utf-8\""
    },
    "bodyFileName": "netgear-soap/login.xml"
  }
}

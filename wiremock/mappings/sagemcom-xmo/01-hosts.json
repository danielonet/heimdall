{
  "request": {
    "method": "POST",
    "urlPath": "/cgi/json-req",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.request[?(@.id == 0)]"
      },
      {
        "matchesJsonPath": "$.request.actions[?(@.method == 'getValue' && @.xpath == 'Device/Hosts/Host')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "sagemcom-xmo/device_list.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
